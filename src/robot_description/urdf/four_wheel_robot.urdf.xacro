<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="four_wheel_robot">

  <!-- ============================================= -->
  <!-- 1. ROBOT DIMENSIONS                           -->
  <!-- ============================================= -->

  <xacro:property name="chassis_length" value="0.30"/>
  <xacro:property name="chassis_width"  value="0.22"/>
  <xacro:property name="chassis_height" value="0.08"/>

  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width"  value="0.035"/>

  <xacro:property name="wheel_x" value="0.10"/>
  <xacro:property name="wheel_y" value="0.13"/>
  <xacro:property name="wheel_z" value="-0.04"/>

  <xacro:property name="lidar_z" value="0.09"/>


  <!-- ============================================= -->
  <!-- 2. MATERIAL COLORS                            -->
  <!-- ============================================= -->

  <material name="blue">
    <color rgba="0.1 0.35 0.85 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>

  <material name="gray">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>


  <!-- ============================================= -->
  <!-- 3. MAIN CHASSIS LINK                          -->
  <!-- ============================================= -->

  <link name="base_link">

    <visual>
      <geometry>
        <box size="${chassis_length}
                   ${chassis_width}
                   ${chassis_height}"/>
      </geometry>

      <material name="blue"/>
    </visual>

    <collision>
      <geometry>
        <box size="${chassis_length}
                   ${chassis_width}
                   ${chassis_height}"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="2.0"/>

      <inertia
        ixx="${2.0*(chassis_width**2 + chassis_height**2)/12.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${2.0*(chassis_length**2 + chassis_height**2)/12.0}"
        iyz="0.0"
        izz="${2.0*(chassis_length**2 + chassis_width**2)/12.0}"/>
    </inertial>

  </link>


  <!-- ============================================= -->
  <!-- 4. REUSABLE WHEEL MACRO                       -->
  <!-- ============================================= -->

  <xacro:macro name="wheel" params="name x y">

    <link name="${name}_wheel">

      <visual>
        <!-- URDF cylinders point along local Z.
             Rotate 90 degrees around X so the
             wheel axle points along local Y. -->
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>

        <geometry>
          <cylinder
            radius="${wheel_radius}"
            length="${wheel_width}"/>
        </geometry>

        <material name="black"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>

        <geometry>
          <cylinder
            radius="${wheel_radius}"
            length="${wheel_width}"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.20"/>

        <inertia
          ixx="${0.20*(3*wheel_radius**2 + wheel_width**2)/12.0}"
          ixy="0.0"
          ixz="0.0"
          iyy="${0.20*wheel_radius**2/2.0}"
          iyz="0.0"
          izz="${0.20*(3*wheel_radius**2 + wheel_width**2)/12.0}"/>
      </inertial>

    </link>

    <joint name="${name}_joint" type="continuous">

      <parent link="base_link"/>
      <child link="${name}_wheel"/>

      <origin xyz="${x} ${y} ${wheel_z}" rpy="0 0 0"/>

      <axis xyz="0 1 0"/>

      <limit effort="10.0" velocity="20.0"/>

      <dynamics damping="0.05" friction="0.0"/>

    </joint>

  </xacro:macro>


  <!-- ============================================= -->
  <!-- 5. FOUR WHEELS                               -->
  <!-- ============================================= -->

  <xacro:wheel name="left_front"
               x="${wheel_x}" y="${wheel_y}"/>

  <xacro:wheel name="left_rear"
               x="${-wheel_x}" y="${wheel_y}"/>

  <xacro:wheel name="right_front"
               x="${wheel_x}" y="${-wheel_y}"/>

  <xacro:wheel name="right_rear"
               x="${-wheel_x}" y="${-wheel_y}"/>


  <!-- ============================================= -->
  <!-- 6. LIDAR LINK                                -->
  <!-- ============================================= -->

  <link name="lidar_link">

    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.04"/>
      </geometry>

      <material name="gray"/>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.04" length="0.04"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.10"/>

      <inertia
        ixx="0.00005333"
        ixy="0.0"
        ixz="0.0"
        iyy="0.00005333"
        iyz="0.0"
        izz="0.00008"/>
    </inertial>

  </link>


  <!-- ============================================= -->
  <!-- 7. FIXED LIDAR MOUNT                         -->
  <!-- ============================================= -->

  <joint name="lidar_joint" type="fixed">

    <parent link="base_link"/>
    <child link="lidar_link"/>

    <origin xyz="0 0 ${lidar_z}" rpy="0 0 0"/>

  </joint>

</robot>

